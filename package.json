{
  "name": "peixairada",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One board for every Claude Code chat on this Mac — live transcripts, lanes, alerts, and a real claude terminal in the chat pane",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "sh scripts/check.sh",
    "verify": "node scripts/verify.mjs",
    "scenario": "node scripts/scenario.mjs",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/headless": "^5.5.0",
    "node-pty": "^1.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^5.5.0"
  }
}
