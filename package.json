{
  "name": "peixairada",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "One board for every Claude Code chat on this Mac — live transcripts, lanes, alerts, and a real claude terminal in the chat pane",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --import ./test/env.mjs --test --test-concurrency=4 test/*.test.mjs",
    "check": "sh scripts/check.sh",
    "lint": "eslint . && node scripts/lint-page.mjs",
    "format": "node scripts/format.mjs",
    "verify": "node scripts/verify.mjs",
    "webkit": "node scripts/webkit.mjs",
    "perf": "node scripts/perf.mjs",
    "shell": "node scripts/shell.mjs",
    "scenario": "node scripts/scenario.mjs",
    "scenarios": "node scripts/scenarios.mjs",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@xterm/addon-serialize": "0.13.0",
    "@xterm/headless": "5.5.0",
    "node-pty": "1.1.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@highlightjs/cdn-assets": "11.12.0",
    "@stylistic/eslint-plugin": "6.0.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "5.5.0",
    "dompurify": "3.4.17",
    "eslint": "10.15.0",
    "eslint-plugin-import-lite": "0.6.0",
    "globals": "17.14.0",
    "marked": "18.1.2",
    "prettier": "3.10.1"
  }
}
